# Cargo target directory
**/target/
**/*.rs.bk

# Icons staging area (populated by scripts/dev.sh or scripts/prod.sh)
desktop/src-tauri/icons/

# Local tenby10 SQLite databases and screenshots (if placed locally)
tenby10.db
screenshots/

# OS metadata
.DS_Store

# Specs, Decisions, and Reviews (local only, do not commit).
# Exception: docs/decisions/ holds the decision records AUDIT.md cites, published so its
# references resolve for a reader of this repository.
/decisions/
specs/
docs/*
!docs/decisions/
ceo_assessment.json
cpo_review.json
investor_memo.json
marketing_review.json

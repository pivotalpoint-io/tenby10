<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Merged into the app bundle's Info.plist by Tauri. These usage-description
         strings let macOS present a proper prompt for the TCC services tenby10 needs.
         Without NSInputMonitoringUsageDescription the app cannot prompt for Input
         Monitoring, which is the permission that gates keyboard/click/scroll capture. -->
    <key>NSInputMonitoringUsageDescription</key>
    <string>tenby10 counts key presses, clicks and scrolls to measure your active work time. It never records which key you pressed.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>tenby10 asks System Events which app and window are in front, to sort your activity into categories.</string>
</dict>
</plist>
